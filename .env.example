# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────
# Redis  (leave as-is when using docker-compose)
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379


# ─────────────────────────────────────────────
# MongoDB (leave as-is when using local/docker)
# ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/dispatch_engine

# ─────────────────────────────────────────────
# Security  (CHANGE THESE — keep them secret)
# ─────────────────────────────────────────────
WEBHOOK_SECRET=change-this-to-a-minimum-32-char-secret
ADMIN_TOKEN=change-this-to-a-secure-admin-bearer-token

# ─────────────────────────────────────────────
# BullMQ Queue Config
# ─────────────────────────────────────────────
QUEUE_NAME=webhook-dispatch
MAX_RETRIES=5
JOB_TIMEOUT_MS=10000

# ─────────────────────────────────────────────
# Idempotency
# ─────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
